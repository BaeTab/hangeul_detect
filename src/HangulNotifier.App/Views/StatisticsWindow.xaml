<dx:ThemedWindow
    x:Class="HangulNotifier.App.Views.StatisticsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    Title="통계 — 한글 맞춤법 알림기" Height="620" Width="760"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 카운트 카드 -->
        <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,14">
            <Border Background="#1F6FE0" CornerRadius="10" Margin="0,0,6,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="오늘" Foreground="#DDEAFF" FontSize="13"/>
                    <TextBlock Text="{Binding TodayCount}" Foreground="White" FontSize="30" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#2AA37A" CornerRadius="10" Margin="6,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="이번 주" Foreground="#DDF6EC" FontSize="13"/>
                    <TextBlock Text="{Binding WeekCount}" Foreground="White" FontSize="30" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#8557D8" CornerRadius="10" Margin="6,0,0,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="이번 달" Foreground="#EBE0FF" FontSize="13"/>
                    <TextBlock Text="{Binding MonthCount}" Foreground="White" FontSize="30" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 최근 30일 추이 -->
        <Border Grid.Row="1" BorderBrush="#22000000" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
            <Grid>
                <TextBlock Text="최근 30일 추이" Margin="12,8" FontWeight="SemiBold" VerticalAlignment="Top"/>
                <dxc:ChartControl Margin="0,30,0,0">
                    <dxc:ChartControl.Legend>
                        <dxc:Legend Visibility="Collapsed"/>
                    </dxc:ChartControl.Legend>
                    <dxc:XYDiagram2D>
                        <dxc:XYDiagram2D.Series>
                            <dxc:BarSideBySideSeries2D
                                DisplayName="감지"
                                DataSource="{Binding DailySeries}"
                                ArgumentDataMember="Day"
                                ValueDataMember="Count"/>
                        </dxc:XYDiagram2D.Series>
                    </dxc:XYDiagram2D>
                </dxc:ChartControl>
            </Grid>
        </Border>

        <!-- 자주 틀리는 맞춤법 TOP 10 -->
        <Border Grid.Row="2" BorderBrush="#22000000" BorderThickness="1" CornerRadius="8">
            <Grid>
                <TextBlock Text="자주 틀리는 맞춤법 TOP 10" Margin="12,8" FontWeight="SemiBold" VerticalAlignment="Top"/>
                <dxg:GridControl Margin="0,30,0,0" ItemsSource="{Binding TopRules}" AutoGenerateColumns="None">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Suggestion" Header="제안" Width="90"/>
                        <dxg:GridColumn FieldName="Description" Header="설명" Width="*"/>
                        <dxg:GridColumn FieldName="Count" Header="횟수" Width="70"/>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AllowEditing="False" ShowGroupPanel="False" AutoWidth="True"/>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </Grid>
        </Border>

        <!-- 전체 삭제 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ClearButton" Content="전체 데이터 삭제" Padding="14,7" Click="ClearButton_Click"/>
        </StackPanel>
    </Grid>
</dx:ThemedWindow>
