<dx:ThemedWindow
    x:Class="HangulNotifier.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="설정 — 한글 맞춤법 알림기" Height="748" Width="600"
    MinHeight="560" MinWidth="540"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Ideal"
    FontFamily="Segoe UI, Malgun Gothic">

    <Grid Background="{StaticResource Brush.AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ 헤더 히어로 ═══ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,22,24,12">
            <Border Width="46" Height="46" CornerRadius="13" Background="{StaticResource Brush.AccentSoft}"
                    VerticalAlignment="Center" Margin="0,0,14,0">
                <Path Style="{StaticResource GlyphIcon}" Data="{StaticResource Icon.Sliders}" Width="26" Height="26"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.H1}" Text="설정"/>
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="한글 맞춤법 실시간 알림기" Margin="0,1,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ═══ 스크롤 카드 영역 ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,24,4">
            <StackPanel Margin="2,4,2,10">

                <!-- 개인정보 배너 -->
                <Border Background="{StaticResource Brush.AccentSoft}" CornerRadius="14" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#FFFFFF"
                                VerticalAlignment="Top" Margin="0,0,13,0">
                            <Path Style="{StaticResource GlyphIcon}" Data="{StaticResource Icon.Shield}"/>
                        </Border>
                        <StackPanel MaxWidth="470">
                            <TextBlock Text="개인정보 보호" Foreground="{StaticResource Brush.Accent}"
                                       FontWeight="SemiBold" FontSize="13.5"/>
                            <TextBlock Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap"
                                       Margin="0,4,0,0" FontSize="12.5" LineHeight="18"
                                       Text="입력 내용은 네트워크로 전송되지 않으며, 비밀번호 입력 시 감지가 자동 중단됩니다. 통계에는 규칙과 시각만 저장되고 입력 텍스트는 저장되지 않습니다."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 알림 신뢰도 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Style="{StaticResource IconChip}">
                                <Path Style="{StaticResource GlyphIcon}" Data="{StaticResource Icon.Bell}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Section}" Text="알림 신뢰도"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="어떤 확신도의 오류를 알릴지 선택합니다"/>
                            </StackPanel>
                        </StackPanel>

                        <CheckBox x:Name="CertainCheck" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource Brush.Certain}" VerticalAlignment="Center" Margin="2,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Certain · 확실한 오류" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource Brush.TextPrimary}"/>
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="언제나 틀린 표기 — 권장 ON"/>
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="SuspectCheck" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource Brush.Suspect}" VerticalAlignment="Center" Margin="2,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Suspect · 문맥상 의심" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource Brush.TextPrimary}"/>
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="문맥에 따라 오류일 수 있음 — 권장 ON"/>
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="InfoCheck" Style="{StaticResource ToggleSwitch}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource Brush.Info}" VerticalAlignment="Center" Margin="2,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Info · 판별 불가 / 참고" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource Brush.TextPrimary}"/>
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="참고용 안내 — 기본 OFF"/>
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- 알림 표시 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Style="{StaticResource IconChip}">
                                <Path Style="{StaticResource GlyphIcon}" Data="{StaticResource Icon.Monitor}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Section}" Text="알림 표시"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="오버레이가 뜨는 시간과 위치"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="76"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Field}" Text="표시 시간"/>
                            <Slider Grid.Column="1" x:Name="DurationSlider" Style="{StaticResource AccentSlider}"
                                    Minimum="500" Maximum="4000" TickFrequency="250" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Text.Field}" HorizontalAlignment="Right"
                                       FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}"
                                       Text="{Binding Value, ElementName=DurationSlider, StringFormat={}{0:0} ms}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Field}" Text="위치"/>
                            <ComboBox Grid.Column="1" x:Name="PositionCombo" Style="{StaticResource ComboInput}"
                                      ItemContainerStyle="{StaticResource ComboInputItem}">
                                <ComboBoxItem Content="캐럿 추적 — 커서 근처에 표시"/>
                                <ComboBoxItem Content="화면 우하단 고정"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 사운드 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Style="{StaticResource IconChip}">
                                <Path Style="{StaticResource GlyphIcon}" Data="{StaticResource Icon.Sound}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Section}" Text="사운드"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="알림 시 소리 재생 여부"/>
                            </StackPanel>
                        </StackPanel>

                        <CheckBox x:Name="SoundCheck" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="알림음 재생" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource Brush.TextPrimary}"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="기본 OFF"/>
                            </StackPanel>
                        </CheckBox>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Field}" Text="볼륨"/>
                            <Slider Grid.Column="1" x:Name="VolumeSlider" Style="{StaticResource AccentSlider}"
                                    Minimum="0" Maximum="1" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 시작 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Style="{StaticResource IconChip}">
                                <Path Style="{StaticResource GlyphIcon}" Data="{StaticResource Icon.Power}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Section}" Text="시작"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="Windows 로그인 시 자동 실행"/>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox x:Name="StartupCheck" Style="{StaticResource ToggleSwitch}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Windows 시작 시 자동 실행" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource Brush.TextPrimary}"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="트레이에 상주하며 백그라운드로 실행됩니다"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- 업데이트 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Style="{StaticResource IconChip}">
                                <Path Style="{StaticResource GlyphIcon}" Data="M12,3.5 V12 M8.4,8.8 L12,12.4 L15.6,8.8 M5,18.5 H19"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Section}" Text="업데이트"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="GitHub 릴리즈에서 새 버전 확인"/>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox x:Name="UpdateCheck" Style="{StaticResource ToggleSwitch}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="새 버전 자동 확인" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource Brush.TextPrimary}"/>
                                <TextBlock Style="{StaticResource Text.Caption}" MaxWidth="430" TextWrapping="Wrap"
                                           Text="기본 OFF · 켜면 GitHub에만 접속해 버전만 확인합니다. 입력·통계는 전송하지 않으며 자동 설치도 하지 않습니다(새 버전은 브라우저로 안내)."/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- 감지 제외 프로세스 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource IconChip}">
                                <Path Style="{StaticResource GlyphIcon}" Data="{StaticResource Icon.Filter}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Section}" Text="감지 제외 프로세스"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="한 줄에 하나씩 (예: keepass.exe)"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBox x:Name="ExcludedBox" Style="{StaticResource InputBox}" Height="86"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <!-- 맞춤법 규칙 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource IconChip}">
                                <Path Style="{StaticResource GlyphIcon}" Data="{StaticResource Icon.Rules}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Section}" Text="맞춤법 규칙 개별 설정"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="개별 규칙을 켜고 끌 수 있습니다"/>
                            </StackPanel>
                        </StackPanel>

                        <ListBox x:Name="RulesList" Style="{StaticResource RuleListBox}" Height="212">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource RuleCheck}"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}" Content="{Binding Label}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,16,0,14"/>

                        <Button x:Name="ClearStatsButton" Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Left" Click="ClearStatsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Trash}" Stroke="{StaticResource Brush.Certain}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16"
                                      Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="통계 데이터 전체 삭제" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ 하단 액션 바 ═══ -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14">
                <Button Style="{StaticResource GhostButton}" Content="취소" MinWidth="104" Margin="0,0,10,0"
                        Click="CancelButton_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="변경사항 저장" MinWidth="150"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</dx:ThemedWindow>
