<Window x:Class="HangulNotifier.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Left="-10000" Top="-10000"
        Opacity="0"
        FontFamily="Segoe UI, Malgun Gothic">

    <!-- 순수 WPF 클릭-스루 오버레이. Activate/Focus/ShowDialog 절대 호출 금지.
         포커스를 뺏으면 사용자의 IME 조합이 끊긴다. -->
    <Border CornerRadius="8" Background="#F22B2B2B" MaxWidth="440">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 신뢰도 색상 바 -->
            <Border x:Name="AccentBar" Grid.Column="0" Background="#E53935" CornerRadius="8,0,0,8"/>

            <StackPanel Grid.Column="1" Margin="13,9,15,11">
                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" TextWrapping="NoWrap">
                    <Run x:Name="WrongRun" Foreground="#FF8A80"/><Run Text="   →   " Foreground="#9E9E9E"/><Run x:Name="SuggestRun" Foreground="#A5D6A7"/>
                </TextBlock>
                <TextBlock x:Name="MessageLine" FontSize="12" Foreground="#D6D6D6"
                           TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="400"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
