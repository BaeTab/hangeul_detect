<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- =========================================================================
         HangulNotifier 디자인 시스템  ·  Premium Light + Indigo–Violet
         한 곳에서 강조색 · 카드 · 그림자 · 커스텀 컨트롤 · 아이콘을 정의한다.
         DevExpress Win11Light 테마 위에 얹혀 앱 고유의 고급 룩을 만든다.
         ========================================================================= -->

    <sys:Double x:Key="Radius.Card">14</sys:Double>

    <!-- ── 컬러 토큰 ─────────────────────────────────────────────────────── -->
    <Color x:Key="Color.Accent">#4F46E5</Color>
    <Color x:Key="Color.Accent2">#7C3AED</Color>

    <SolidColorBrush x:Key="Brush.Accent"        Color="#4F46E5"/>
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#4338CA"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#3730A3"/>
    <SolidColorBrush x:Key="Brush.AccentSoft"    Color="#ECEBFC"/>
    <SolidColorBrush x:Key="Brush.AppBg"         Color="#F4F5FB"/>
    <SolidColorBrush x:Key="Brush.Surface"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt"    Color="#FAFAFE"/>
    <SolidColorBrush x:Key="Brush.Border"        Color="#E8E9F3"/>
    <SolidColorBrush x:Key="Brush.BorderStrong"  Color="#D6D9EA"/>
    <SolidColorBrush x:Key="Brush.Track"         Color="#DFE2EF"/>
    <SolidColorBrush x:Key="Brush.TextPrimary"   Color="#1C2033"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5A6079"/>
    <SolidColorBrush x:Key="Brush.TextMuted"     Color="#8E93A6"/>

    <SolidColorBrush x:Key="Brush.Certain" Color="#E5484D"/>
    <SolidColorBrush x:Key="Brush.Suspect" Color="#E8A100"/>
    <SolidColorBrush x:Key="Brush.Info"    Color="#9096A8"/>

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#4F46E5"/>
        <GradientStop Offset="1" Color="#7C3AED"/>
    </LinearGradientBrush>

    <!-- 통계 카드용 그라데이션 (쿨톤 프리미엄 패밀리) -->
    <LinearGradientBrush x:Key="Brush.Stat1" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#4F46E5"/>
        <GradientStop Offset="1" Color="#7C3AED"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Stat2" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0EA5E9"/>
        <GradientStop Offset="1" Color="#2563EB"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Stat3" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#8B5CF6"/>
        <GradientStop Offset="1" Color="#6D28D9"/>
    </LinearGradientBrush>

    <!-- ── 아이콘 지오메트리 (24 유닛 좌표계, stroke 렌더) ─────────────────── -->
    <Geometry x:Key="Icon.Bell">M12,3 C9.24,3 7,5.24 7,8 v3.2 L5.4,13.8 a0.6,0.6 0 0 0 0.5,0.95 h12.2 a0.6,0.6 0 0 0 0.5,-0.95 L17,11.2 V8 C17,5.24 14.76,3 12,3 Z M9.7,16 a2.3,2.3 0 0 0 4.6,0</Geometry>
    <Geometry x:Key="Icon.Monitor">M4.5,5 h15 a1.5,1.5 0 0 1 1.5,1.5 v8 a1.5,1.5 0 0 1 -1.5,1.5 h-15 a1.5,1.5 0 0 1 -1.5,-1.5 v-8 a1.5,1.5 0 0 1 1.5,-1.5 Z M9,20 h6 M12,16 v4</Geometry>
    <Geometry x:Key="Icon.Sound">M4,9.5 h2.8 L11,6 v12 L6.8,14.5 H4 Z M14.5,9 a4,4 0 0 1 0,6 M16.8,7 a7,7 0 0 1 0,10</Geometry>
    <Geometry x:Key="Icon.Power">M12,3 v8 M7.6,6.2 a6.5,6.5 0 1 0 8.8,0</Geometry>
    <Geometry x:Key="Icon.Filter">M4,5.5 h16 a0.5,0.5 0 0 1 0.38,0.83 L14.5,12.5 v5.5 a0.5,0.5 0 0 1 -0.72,0.45 l-3,-1.5 a0.5,0.5 0 0 1 -0.28,-0.45 v-4 L3.62,6.33 A0.5,0.5 0 0 1 4,5.5 Z</Geometry>
    <Geometry x:Key="Icon.Rules">M4,7 l1.2,1.2 L7.5,5.8 M10,7 h10 M4,12 l1.2,1.2 L7.5,10.8 M10,12 h10 M4,17 l1.2,1.2 L7.5,15.8 M10,17 h10</Geometry>
    <Geometry x:Key="Icon.Shield">M12,3 L19,6 v5 c0,4.4 -3.1,7.6 -7,9 c-3.9,-1.4 -7,-4.6 -7,-9 V6 Z M9,12 l2,2 l4.2,-4.2</Geometry>
    <Geometry x:Key="Icon.Chart">M4,20 H20 M7,20 V13 M12,20 V7 M17,20 V10</Geometry>
    <Geometry x:Key="Icon.Award">M8,4 h8 v3.5 a4,4 0 0 1 -8,0 Z M8,5 H6.2 a2,2 0 0 0 1.9,2.6 M16,5 h1.8 a2,2 0 0 1 -1.9,2.6 M12,11.5 V15 M9,20 h6 M9.5,20 L11,15.5 M14.5,20 L13,15.5</Geometry>
    <Geometry x:Key="Icon.Trash">M5.5,7 H18.5 M9.5,7 V5.2 A0.7,0.7 0 0 1 10.2,4.5 h3.6 a0.7,0.7 0 0 1 0.7,0.7 V7 M7.5,7 V18.5 A1,1 0 0 0 8.5,19.5 h7 a1,1 0 0 0 1,-1 V7 M10.2,10.5 V16 M13.8,10.5 V16</Geometry>
    <Geometry x:Key="Icon.Calendar">M5.5,6 H18.5 A1.5,1.5 0 0 1 20,7.5 V18 A1.5,1.5 0 0 1 18.5,19.5 H5.5 A1.5,1.5 0 0 1 4,18 V7.5 A1.5,1.5 0 0 1 5.5,6 Z M4,10 H20 M8,4 V8 M16,4 V8</Geometry>
    <Geometry x:Key="Icon.Sliders">M4,7 h9 M17,7 h3 M4,12 h3 M11,12 h9 M4,17 h11 M19,17 h1 M15,7 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M9,12 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M17,17 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0</Geometry>

    <!-- ── 타이포 스타일 ─────────────────────────────────────────────────── -->
    <Style x:Key="Text.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
    </Style>
    <Style x:Key="Text.Section" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Text.Field" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- ── 카드 & 아이콘 칩 ──────────────────────────────────────────────── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#232A45" BlurRadius="24" ShadowDepth="5" Opacity="0.09" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconChip" TargetType="Border">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <Style x:Key="GlyphIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource Brush.Accent}"/>
        <Setter Property="StrokeThickness" Value="1.7"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── Primary 버튼 (강조 그라데이션) ────────────────────────────────── -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="26,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource Brush.AccentGradient}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.Effect>
                            <DropShadowEffect Color="#4F46E5" BlurRadius="16" ShadowDepth="4" Opacity="0.38" Direction="270"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentPressed}"/>
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.975" ScaleY="0.975"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Ghost(보조) 버튼 ─────────────────────────────────────────────── -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F2F8"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E8EAF4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Danger(위험) 버튼 ────────────────────────────────────────────── -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.Certain}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="9" Background="Transparent"
                            BorderBrush="#F1C4C6" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FDECEC"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Certain}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FADCDC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 토글 스위치 (라벨 좌 / 스위치 우, 카드 폭 채움) ──────────────────── -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Border Grid.Column="1" x:Name="Track" Width="46" Height="26" CornerRadius="13"
                                Background="{StaticResource Brush.Track}" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Border x:Name="Thumb" Width="20" Height="20" CornerRadius="10" Background="White"
                                    HorizontalAlignment="Left" Margin="3,0,0,0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="TT" X="0"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect Color="#1C2033" BlurRadius="4" ShadowDepth="1" Opacity="0.28" Direction="270"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.AccentGradient}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TT" Storyboard.TargetProperty="X"
                                                         To="20" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TT" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 규칙 리스트용 컴팩트 체크 (체크박스 좌 / 라벨 우) ─────────────────── -->
    <Style x:Key="RuleCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Grid.Column="0" Width="19" Height="19" CornerRadius="6"
                                Background="White" BorderBrush="{StaticResource Brush.BorderStrong}"
                                BorderThickness="1.4" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Path x:Name="Check" Data="M4,9.5 L8,13 L15,5.5" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="12" Height="12" Opacity="0"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.AccentGradient}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="Check" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 슬라이더 (강조 채움 + 흰 썸) ──────────────────────────────────── -->
    <Style x:Key="SliderRepeatFilled" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                            Background="{StaticResource Brush.AccentGradient}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderRepeatEmpty" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                            Background="{StaticResource Brush.Track}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="20" Height="20" Background="Transparent">
                        <Ellipse Width="18" Height="18" Fill="White" Stroke="{StaticResource Brush.Accent}"
                                 StrokeThickness="2.5">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#1C2033" BlurRadius="6" ShadowDepth="1" Opacity="0.28" Direction="270"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AccentSlider" TargetType="Slider">
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeatFilled}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeatEmpty}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 입력 박스 (라운드, 포커스 강조 테두리) ────────────────────────── -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="9" Background="{StaticResource Brush.SurfaceAlt}"
                            BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1.3">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 콤보 박스 (라운드, 강조 팝업) ─────────────────────────────────── -->
    <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
        <Border x:Name="Bd" CornerRadius="9" Background="{StaticResource Brush.SurfaceAlt}"
                BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1.3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Path Grid.Column="1" Data="M2,4 L6,8 L10,4" Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ComboInput" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Template="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="Sel" Margin="12,0,34,0" VerticalAlignment="Center"
                                          HorizontalAlignment="Left" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                               PopupAnimation="Slide" VerticalOffset="4">
                            <Border Background="{StaticResource Brush.Surface}" CornerRadius="10"
                                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect Color="#232A45" BlurRadius="20" ShadowDepth="4" Opacity="0.16" Direction="270"/>
                                </Border.Effect>
                                <ScrollViewer MaxHeight="220">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboInputItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 규칙 리스트 박스 (테두리 없는 컨테이너 + 행 호버) ────────────────── -->
    <Style x:Key="RuleListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="10,7">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F4F5FB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RuleListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource RuleListItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border CornerRadius="10" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Margin="{TemplateBinding Padding}" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
